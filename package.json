{
  "name": "dsh-session-delete",
  "version": "0.5.0",
  "private": true,
  "description": "One-click session deletion for the Harness sidebar: moves the session log and its per-conversation artifact directory (.dsh-sessions/<session-id>/) to the Windows Recycle Bin (recoverable) after stopping running work.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "icon": "./icon.svg",
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "icon.svg",
    "locale/*.json"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zenghang25/dsh-session-delete.git"
  },
  "homepage": "https://github.com/zenghang25/dsh-session-delete#readme",
  "bugs": {
    "url": "https://github.com/zenghang25/dsh-session-delete/issues"
  },
  "author": "zenghang25",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "session",
    "delete",
    "artifacts"
  ],
  "license": "MIT"
}
